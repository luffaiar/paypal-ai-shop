PORT=3000

# PayPal Sandbox Credentials
# Get these from https://developer.paypal.com -> Dashboard -> Apps & Credentials
PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_CLIENT_SECRET
PAYPAL_MODE=sandbox

# Optional: Google Gemini API Key for live LLM Tool Calling
# If omitted or left as default, the built-in deterministic concierge agent runs out of the box!
GEMINI_API_KEY=
